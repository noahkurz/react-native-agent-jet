{
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"types": ["node"],
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"noUncheckedIndexedAccess": true,
		"forceConsistentCasingInFileNames": true,
		"rootDir": ".",
		"outDir": "dist"
	},
	"include": ["host", "src/protocol.ts"]
}
