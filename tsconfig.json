{
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"lib": ["ES2022"],
		"types": ["react-native"],
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"noUncheckedIndexedAccess": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"resolveJsonModule": true
	},
	"include": ["src"]
}
